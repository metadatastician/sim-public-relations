[metadata]
version = "0.2.0"
last-updated = "2026-08-18"

[project]
name = "sim-public-relations"
product-name = "PR Practice Lab"
purpose = "Create evidence-driven fictional practice for people blocked from entering public relations and communications by the prior-experience trap."

[non-negotiable-boundaries]
rules = [
  "Never represent simulated work or elapsed simulation time as employment, placement hours, live client work, professional qualification or accredited CPD.",
  "Never deliver authored reality, response rules, assessment interpretations or model routes to a learner client or learner-controlled AI context.",
  "Keep facts, disclosures, interpretations, assumptions, approved messages, outputs, outcomes and impact distinct.",
  "AI output is not evidence; permitted AI use must be declared and verified, and human accountability remains.",
  "Do not contact real people, publish to live services or use live personal contact data in authored scenarios.",
  "Do not infer competence from campaign outcome, prose fluency, accent, social background, personal following or tool access alone.",
]

[required-reading]
files = [
  "README.adoc",
  "docs/foundation/foundation-spec-v0.1.adoc",
  "docs/architecture/system-architecture.adoc",
  "docs/assessment/validity-limitations.adoc",
  "docs/KNOWN-DEBT.adoc",
]

[validation]
commands = [
  "bash tools/validate-scenario.sh",
  "bash tools/test-scenario-boundary.sh",
]

[work-allocation]
current = [
  "Product foundation, competency model and Northstar Mobility authored scenario implemented in the Phase A publication candidate.",
  "Deterministic native replay kernel implements plural routes, separate competency/outcome reporting and integrity-critical failure.",
  "Next implementation boundary: interactive learner shell and persistence without hidden-truth leakage.",
]
