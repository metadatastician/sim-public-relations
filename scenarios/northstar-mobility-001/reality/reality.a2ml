# TRUSTED HOST ONLY. Excluded from learner clients, exports and AI contexts.
[reality]
scenario = "northstar-mobility-001@0.1.0"
fictional = true
delivery = "never-to-learner-client"

[fixed-history]
partner-approval-state = "bellweather-partner-approval-is-withheld"
