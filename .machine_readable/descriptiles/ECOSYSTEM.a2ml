# ECOSYSTEM.a2ml — Ecosystem position for PR Practice Lab.

[metadata]
project = "sim-public-relations"
ecosystem = "metadatastician"
last-updated = "2026-08-18"

[product]
type = "application"
purpose = "Evidence-driven, time-aware fictional practice for people developing public-relations and communications judgement, with event-linked assessment separated from campaign consequence."
what-this-is-not = [
  "an agency, employer or live client service",
  "employment, a placement or supervised professional experience",
  "a professional qualification, accredited CPD or guarantee of competence",
  "a live-contact, media-database or social-publishing tool",
  "authoritative professional scoring (the rule pack and rubric are provisional and unreviewed)",
  "rsr-template-repo (the scaffold from which this repository began)",
  "a complete learner product today (the current UI is a replay CLI)",
]

[pipeline]
position = "experimental vertical slice"
chain = "professional references → authored fictional scenario → deterministic event kernel → evidence-linked debrief"
notes = "The current repository implements the product foundation, one scenario and a deterministic native replay slice."
coordination = "metadatastician"

[related-projects]
projects = [
  { name = "metadatastician/sim-insolvency", relationship = "design-lineage", notes = "Source of the evidence-driven epistemic and plural-route assessment pattern; no runtime dependency." },
  { name = "hyperpolymath/standards", relationship = "repository-standards", notes = "Canonical estate-wide repository and publication policies." },
]

[boundaries]
notes = "The sharpest internal boundary is scenarios/*/reality/: its content must never reach learner artefacts or learner-controlled AI. The sharpest external boundary is representational: every output remains fictional simulated practice, never a credential or employment claim."
