#
# AGENTIC.a2ml — AI agent constraints for PR Practice Lab.

[metadata]
project = "sim-public-relations"
last-updated = "2026-08-18"
manifest = "0-AI-MANIFEST.a2ml"

[agent-permissions]
can-edit-source = true
can-edit-tests = true
can-edit-docs = true
can-edit-config = true
can-create-files = true

[hard-rules]
rules = [
  "Never move, copy or quote hidden scenario reality, response rules, assessment interpretations or model routes into learner-visible artefacts, AI prompts, issues or pull-request bodies.",
  "Never represent simulation output as employment, placement hours, live client work, a professional qualification or accredited CPD.",
  "Never soften the fictional-practice disclaimer or claim professional validation that has not occurred.",
  "AI output is not evidence; permitted AI use must be declared and verified, and human accountability remains.",
  "Never weaken a gate to make it pass, and never count a negative scan that has not been proved with a planted positive defect.",
  "Never infer competence from campaign outcome, prose fluency, accent, social background, personal following or tool access alone.",
  "Never commit secrets or credentials.",
]

[before-you-change-anything]
steps = [
  "Read 0-AI-MANIFEST.a2ml and every file listed under its required-reading section.",
  "Read docs/KNOWN-DEBT.adoc so known gaps are not rediscovered or silently overclaimed.",
  "Run the product golden path before and after material source or scenario changes.",
]

[maintenance-integrity]
fail-closed = true
require-evidence-per-step = true
allow-silent-skip = false
require-rerun-after-fix = true
release-claim-requires-hard-pass = true

[methodology]
instructions-dir = ".machine_readable/bot_directives/"
default-mode = "hybrid"

[automation-hooks]
on-enter = "Read 0-AI-MANIFEST.a2ml, then the required product and descriptile files."
on-exit = "Report exact checks run, their horizon and all remaining known debt."
on-commit = "Run the product golden path and verify the commit signature."
