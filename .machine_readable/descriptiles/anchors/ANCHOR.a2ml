#
# ANCHOR.a2ml — Stable identity and release boundary for PR Practice Lab.

[metadata]
version = "1.0.0"
last-updated = "2026-08-18"

[anchor]
schema = "hyperpolymath.anchor/1"
repo = "metadatastician/sim-public-relations"
authority = "upstream-canonical"
purpose = [
  "Provide evidence-driven fictional practice for people blocked from entering public-relations and communications by the prior-experience trap.",
  "Keep authored reality separate from learner-visible evidence and learner-controlled AI.",
  "Assess observable professional reasoning separately from campaign consequence.",
]

[identity]
project = "PR Practice Lab"
kind = "application"
one-sentence = "A deterministic, evidence-driven simulator for practising public-relations and communications judgement in fictional scenarios."
domain = "public-relations and communications professional learning"

[invariants]
items = [
  "Simulated work is never represented as employment, placement hours, live client work, a qualification or accredited CPD.",
  "Hidden authored reality, response rules and assessment interpretations never enter learner clients or learner-controlled AI contexts.",
  "Facts, disclosures, interpretations, assumptions, approved messages, outputs, outcomes and impact remain distinct.",
  "Campaign outcome and learner competence are reported separately, and more than one route may be defensible.",
  "Provisional and unreviewed professional material never produces authoritative scoring.",
]

[implementation-policy]
allowed = ["Zig", "Idris2", "Scheme", "Shell", "Just", "AsciiDoc", "Markdown", "a2ml"]
forbidden = ["Python", "Go", "Nix", "AGPL"]

[golden-path]
smoke-test-command = [
  "zig build test",
  "zig build run -- golden",
  "bash tools/validate-scenario.sh",
  "bash tools/test-scenario-boundary.sh",
]
success-criteria = [
  "Native event, route and assessment tests pass",
  "All implemented golden routes replay deterministically",
  "Scenario structure and claim boundaries pass",
  "All planted scenario-boundary defects are rejected",
]

[semantic-authority-files]
product-contract = "docs/foundation/foundation-spec-v0.1.adoc"
architecture = "docs/architecture/system-architecture.adoc"
assessment-limitations = "docs/assessment/validity-limitations.adoc"
known-debt = "docs/KNOWN-DEBT.adoc"
